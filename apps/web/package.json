{
  "name": "trivia-party-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:a11y": "pnpm lint --cache --report-unused-disable-directives",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test": "vitest",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:e2e": "cross-env VITE_SUPABASE_DISABLED=true playwright test",
    "test:performance": "vitest run --config vitest.performance.config.ts",
    "test:ci": "pnpm lint && pnpm test:unit && pnpm test:contract && pnpm test:e2e && pnpm test:performance"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.0.4",
    "@supabase/supabase-js": "^2.45.0",
    "@tanstack/react-query": "^5.59.0",
    "clsx": "^2.1.1",
    "qr-code-styling": "^1.8.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^6.26.2",
    "shadcn-ui": "^0.9.0",
    "tailwind-merge": "^2.5.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.9.2",
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.4.5",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "jsdom": "^27.0.0",
    "msw": "^2.6.0",
    "postcss": "^8.4.41",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.10",
    "tslib": "^2.8.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.4"
  }
}
